# Copy to .env for local development. Real values live in AWS Secrets Manager.
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:1420,tauri://localhost
# 32 random bytes, base64url, sealing TOTP secrets at rest. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Zvault
