# Copy to .env for local development. Real values live in AWS Secrets Manager.
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:1420,tauri://localhost

# PostgreSQL (Amazon RDS/Aurora in production). Run `pnpm --filter @zvault/api db:migrate` after changing it.
DATABASE_URL=postgres://zvault:zvault@localhost:5432/zvault
DATABASE_SSL=false

# 32+ random characters, e.g. `openssl rand -base64 48`. Required in production.
SERVER_SECRET=

# Minutes a login session lasts.
SESSION_TTL_MINUTES=720

# Email. `log` prints messages (with verification codes) to the server log and
# is refused in production. Set MAIL_TRANSPORT=smtp and fill in the rest to send.
MAIL_TRANSPORT=log
MAIL_FROM="Zvault <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465). false requires STARTTLS.
SMTP_SECURE=false
# Development only: plaintext SMTP for a local catcher such as Mailpit.
SMTP_ALLOW_INSECURE=false
SMTP_USER=
SMTP_PASS=
