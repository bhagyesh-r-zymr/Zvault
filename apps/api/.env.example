# Copy to .env for local development. Real values live in AWS Secrets Manager.
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:1420,tauri://localhost

# PostgreSQL (Amazon RDS/Aurora in production). Run `pnpm --filter @zvault/api db:migrate` after changing it.
DATABASE_URL=postgres://zvault:zvault@localhost:5432/zvault
DATABASE_SSL=false
# Or, instead of DATABASE_URL (this is what the AWS stack sets):
# DATABASE_HOST= DATABASE_PORT=5432 DATABASE_NAME= DATABASE_USER= DATABASE_PASSWORD=

# 32+ random characters, e.g. `openssl rand -base64 48`. Required in production.
SERVER_SECRET=


# Email. `log` prints messages (with verification codes) to the server log and
# is refused in production. Set MAIL_TRANSPORT=smtp (or ses) and fill in the rest to send.
MAIL_TRANSPORT=log
MAIL_FROM="Zvault <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465). false requires STARTTLS.
SMTP_SECURE=false
# Development only: plaintext SMTP for a local catcher such as Mailpit.
SMTP_ALLOW_INSECURE=false
SMTP_USER=
SMTP_PASS=

# Or MAIL_TRANSPORT=ses to send via the Amazon SES API with the IAM role (used on AWS).
SES_FROM_ADDRESS=
SES_CONFIGURATION_SET=

# 32 random bytes, base64url, sealing TOTP secrets at rest. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Zvault
