{
  "name": "@zvault/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests: Playwright for the landing page and share page, WebdriverIO + tauri-driver for the Mac app (built on Linux).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:web": "playwright test",
    "test:web:update": "playwright test --update-snapshots",
    "test:desktop": "wdio run desktop/wdio.conf.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "typescript": "~5.9.3",
    "webdriverio": "^9.0.0"
  }
}
