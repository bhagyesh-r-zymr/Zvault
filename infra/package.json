{
  "name": "@zvault/infra",
  "version": "0.0.0",
  "private": true,
  "description": "AWS infrastructure for the Zvault API (AWS CDK). Synth only in CI; deploys are run by a human.",
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth --quiet -c zvault:allowPlaceholders=true",
    "diff": "cdk diff",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.270.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^22.20.4",
    "aws-cdk": "^2.1143.0",
    "vitest": "^5.0.1"
  }
}
